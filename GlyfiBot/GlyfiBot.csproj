<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RollForward>Major</RollForward>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<InvariantGlobalization>true</InvariantGlobalization>
		<!-- AOT Options -->
		<PublishAot>true</PublishAot>
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishTrimmed>true</PublishTrimmed>
		<OptimizationPreference>Speed</OptimizationPreference>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NetCord" Version="1.0.0-beta.18"/>
		<PackageReference Include="NetCord.Services" Version="1.0.0-beta.18"/>
		<PackageReference Include="JetBrains.Annotations" Version="2026.2.0"/>
		<PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.1.0"/>
		<PackageReference Include="Whisper.net" Version="1.9.1"/>
		<!-- This package is for the CPU runtime, but it brings a LOT of extra runtime files with it that I don't want. -->
		<!--<PackageReference Include="Whisper.net.Runtime" Version="1.9.1"/>-->
		<PackageReference Include="Whisper.net.Runtime.Cuda.Linux" Version="1.9.1"/>
		<PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.1"/>
		<PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1"/>
	</ItemGroup>

	<PropertyGroup>
		<SixLaborsLicenseFile>../licences/sixlabors.lic</SixLaborsLicenseFile>
	</PropertyGroup>

</Project>
